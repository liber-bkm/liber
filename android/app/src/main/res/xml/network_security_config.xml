<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted for loopback only. The embedded server speaks
     plain HTTP on 127.0.0.1; some firmware blocks even that unless it is
     declared explicitly. Everything else keeps the platform default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
