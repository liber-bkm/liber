# Maintainer: liber <https://github.com/liber-bkm/liber>
pkgname=liber
pkgver=@VERSION@
pkgrel=1
pkgdesc="A small, dependency-free CLI bookmark manager (html + markdown + archive)"
arch=('x86_64')
url="https://github.com/liber-bkm/liber"
license=('GPL')
optdepends=(
    'fzf: fuzzy picker for liber -s'
    'single-file-cli: full-page archives (liber -a, archive_backend=single-file)'
    'monolith: HTML archival alternative (archive_backend=monolith)'
)
source=("${pkgname}-${pkgver}::https://github.com/liber-bkm/liber/releases/download/${pkgver}/liber"
        "SHA256SUMS.txt::https://github.com/liber-bkm/liber/releases/download/${pkgver}/SHA256SUMS.txt")
sha256sums=('SKIP' 'SKIP')

package() {
    install -Dm755 "${srcdir}/${pkgname}-${pkgver}" "${pkgdir}/usr/bin/liber"
    "${srcdir}/${pkgname}-${pkgver}" completion bash > "${srcdir}/liber"
    "${srcdir}/${pkgname}-${pkgver}" completion zsh > "${srcdir}/_liber"
    "${srcdir}/${pkgname}-${pkgver}" completion fish > "${srcdir}/liber.fish"
    install -Dm644 "${srcdir}/liber" "${pkgdir}/usr/share/bash-completion/completions/liber"
    install -Dm644 "${srcdir}/_liber" "${pkgdir}/usr/share/zsh/site-functions/_liber"
    install -Dm644 "${srcdir}/liber.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/liber.fish"
}
