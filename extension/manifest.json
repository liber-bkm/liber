{
    "manifest_version": 3,
    "name": "liber",
    "version": "0.11.4",
    "description": "One-click capture to your local-first liber library.",
    "action": {
        "default_title": "Save to liber",
        "default_popup": "popup.html",
        "default_icon": {
            "32": "icons/32x32.png",
            "128": "icons/128x128.png"
        }
    },
    "icons": {
        "32": "icons/32x32.png",
        "128": "icons/128x128.png"
    },
    "options_page": "options.html",
    "background": {
        "service_worker": "background.js",
        "scripts": ["background.js"]
    },
    "permissions": ["storage", "contextMenus", "activeTab"],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "browser_specific_settings": {
        "gecko": {
            "id": "liber@liber-bkm.github.io"
        }
    }
}
